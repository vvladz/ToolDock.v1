{
  "variables": {
    "farshell.server": "127.0.0.1:7777"
  },
  "tools": {
    "farshell": {
      "repo": "owner/farshell",
      "asset": "farshell-win-x64.zip",
      "enabled": true,
      "commands": {
        "farshell": {
          "executable": "farshell.exe",
          "environment": {
            "FARSHELL_SERVER": {
              "variable": "farshell.server"
            },
            "OPENAI_API_KEY": {
              "secret": "openai.api-key"
            }
          }
        }
      },
      "daemons": {
        "farshell": {
          "executable": "farshelld.exe",
          "autostart": true,
          "restartOnUpdate": true,
          "environment": {
            "LOG_LEVEL": "info"
          }
        }
      }
    },
    "devproxy": {
      "repo": "owner/devproxy",
      "asset": "devproxy-win-x64.zip",
      "enabled": true,
      "commands": {
        "devproxy": {
          "executable": "app/devproxy.exe"
        }
      }
    },
    "ngrok": {
      "url": "https://bin.ngrok.com/c/bNyj1mQVY4c/ngrok-v3-stable-windows-amd64.zip",
      "commands": {
        "ngrok": {
          "executable": "ngrok.exe"
        }
      }
    },
    "helper": {
      "url": "https://example.org/download/helper.exe",
      "format": "file",
      "fileName": "helper.exe",
      "commands": {
        "helper": {
          "executable": "helper.exe"
        }
      }
    }
  }
}
